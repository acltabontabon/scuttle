{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scuttle",
  "version": "0.1.0-alpha.2",
  "identifier": "app.scuttle.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Scuttle",
        "label": "main",
        "visible": false,
        "width": 1180,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 800,
        "maxWidth": 1180,
        "maxHeight": 800,
        "resizable": false,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#F4EFE6",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "UNSET: paste the public key printed by `npm run tauri signer generate` here (see docs/updates.md)",
      "endpoints": [
        "https://github.com/acltabontabon/scuttle/releases/download/updater-channels/{{channel}}.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Finds what your computer left behind.",
    "longDescription": "Scuttle rummages through the forgotten corners of your computer and shows you what turned up, with the evidence for why it noticed.",
    "copyright": "Licensed under the Apache License 2.0",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
